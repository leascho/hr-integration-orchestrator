# Local development defaults only. All values are fictional and non-secret.
# Docker Compose does NOT need a .env file; defaults are defined in docker-compose.yml.
# Copy to .env only if you want to override values. Never commit .env.

# Local-only demo database credentials (not a real secret).
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=orchestrator
DATABASE_URL=postgresql+psycopg://orchestrator:local-dev-only@postgres:5432/orchestrator

LOG_LEVEL=INFO

IDENTITY_SERVICE_BASE_URL=http://mock-downstream:8100/identity
COLLABORATION_SERVICE_BASE_URL=http://mock-downstream:8100/collaboration
NOTIFICATION_SERVICE_BASE_URL=http://mock-downstream:8100/notification
CONNECTOR_TIMEOUT_SECONDS=5

# 1 initial attempt + RETRY_MAX_RETRIES retries, delays: base * 2^(n-1), capped.
RETRY_MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4

# Failure simulation (mock downstream service only)
SIMULATE_IDENTITY_TIMEOUT=false
SIMULATE_IDENTITY_TIMEOUT_FAILURES=2
SIMULATE_COLLABORATION_FAILURE=false
SIMULATE_NOTIFICATION_FAILURE=false

